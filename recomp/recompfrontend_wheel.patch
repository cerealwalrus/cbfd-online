+// (Conker) The scroll wheel as two buttons (input ids mouse_wheel_up and mouse_wheel_down, past SDL's): each notch a press of its own,
+// held 50 ms and let go for 40 ms before the next (notches that come quicker wait their turn, 4 at most), so a game reading the
+// buttons once a frame sees every notch as one press.
+namespace {
+    struct WheelPulse {
+        int pending = 0;
+        std::chrono::steady_clock::time_point until{};
+        bool active = false;
+    };
+    std::mutex wheel_mutex;
+    WheelPulse wheel_pulses[2];
+    constexpr auto wheel_press = std::chrono::milliseconds(50), wheel_gap = std::chrono::milliseconds(40);
+
+    void wheel_notch(int which) {
+        std::lock_guard lock{ wheel_mutex };
+        WheelPulse& w = wheel_pulses[which];
+        if (w.pending < 4) {
+            w.pending++;
+        }
+    }
+
+    bool wheel_held(int which) {
+        std::lock_guard lock{ wheel_mutex };
+        WheelPulse& w = wheel_pulses[which];
+        const auto now = std::chrono::steady_clock::now();
+        if (w.active) {
+            if (now < w.until) {
+                return true;
+            }
+            w.active = false;
+            w.until = w.until + wheel_gap;
+        }
+        if (now < w.until || w.pending == 0) {
+            return false;
+        }
+        w.pending--;
+        w.active = true;
+        w.until = now + wheel_press;
+        return true;
+    }
+}
+
 // Mouse buttons are numbered as SDL numbers them (SDL_BUTTON_LEFT is 1).
 static bool mouse_button_state(int button) {
+    if (button == recompinput::mouse_wheel_up) {
+        return wheel_held(0);
+    }
+    if (button == recompinput::mouse_wheel_down) {
+        return wheel_held(1);
+    }
     return button >= 1 && button <= 32 && (InputState.mouse_buttons & SDL_BUTTON(button)) != 0;
 }
 
@@ -395,4 +445,8 @@ void recompinput::add_mouse_deltas(float delta_x, float delta_y) {
 }
 void recompinput::add_mouse_wheel_delta(int32_t delta) {
     InputState.mouse_wheel_pos.fetch_add(delta);
+    // (Conker) each notch a press of the wheel's button (up the wheel turned away from you)
+    for (int32_t i = 0; i < std::min<int32_t>(std::abs(delta), 4); i++) {
+        wheel_notch(delta > 0 ? 0 : 1);
+    }
 }
