 static std::atomic_bool cursor_enabled = true;
 
+static std::function<void()> quit_to_launcher;
+
+void recompui::set_quit_to_launcher(std::function<void()> handler) {
+    quit_to_launcher = std::move(handler);
+}
+
 void recompui::open_quit_game_prompt() {
+    if (quit_to_launcher) {
+        recompui::open_choice_prompt(
+            "Quit to the launcher?",
+            "The game stops and you go back to the launcher. Any progress since your last save will be lost.",
+            "Quit",
+            "Cancel",
+            []() {
+                quit_to_launcher();
+            },
+            []() {},
+            recompui::ButtonStyle::Danger,
+            recompui::ButtonStyle::Tertiary,
+            true
+        );
+        return;
+    }
     recompui::open_choice_prompt(
         "Are you sure you want to quit?",
         "Any progress since your last save will be lost.",
