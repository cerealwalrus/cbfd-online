+void ConfigPageControls::style_device_buttons() {
+    if (multiplayer_enabled) {
+        return;
+    }
+    if (cont_button != nullptr) {
+        cont_button->apply_button_style(single_player_show_keyboard_mappings ? ButtonStyle::Basic : ButtonStyle::Primary);
+    }
+    if (keyboard_button != nullptr) {
+        keyboard_button->apply_button_style(single_player_show_keyboard_mappings ? ButtonStyle::Primary : ButtonStyle::Basic);
+    }
+}
